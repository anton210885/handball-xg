# Nach .env kopieren und ausfüllen.
# RapidAPI-Schlüssel für die HandballAPI (Quoten)
RAPIDAPI_KEY=
# Optional: anderer Speicherort für die SQLite-Datenbank
# DB_PATH=data/handball.db

# Betrieb im Internet: Passwort für die Webseite (leer = kein Login, z. B. lokal)
APP_PASSWORD=
# Hintergrund-Jobs abschalten (0 = aus), z. B. auf dem PC, wenn der Server läuft
# ODDSPAPI_SYNC_HOURS=0
# AUTO_IMPORT_HOURS=0
# VERIFY_MINUTES=0
