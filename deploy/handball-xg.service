[Unit]
Description=Handball xG
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP__/backend
ExecStart=__APP__/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8011 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
StandardOutput=append:__APP__/backend/data/server.log
StandardError=append:__APP__/backend/data/server.log

[Install]
WantedBy=multi-user.target
